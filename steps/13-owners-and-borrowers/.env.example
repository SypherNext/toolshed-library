# Copy this file to .env and keep .env out of Git.
DATABASE_URL=postgres://toolshed:toolshed@localhost:18842/toolshed
# Better Auth signs session cookies with this. Make your own (see the README), at least 32 characters.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# The address people use to open Toolshed.
BETTER_AUTH_URL=http://localhost:18840
